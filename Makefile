# ============================================
# 新词检测器 Makefile
# ============================================

# 编译器配置
CC = gcc
CFLAGS = -g -Wall -Wextra

# 目标可执行文件
TARGET = detector.exe

# 源文件（所有 .c 文件都在 src/ 下）
SRCS = src/main.c \
       src/wordlist.c \
       src/tokenizer.c \
       src/detector.c \
       src/io_utils.c

# 把 src/*.c 转成 src/*.o
OBJS = $(SRCS:.c=.o)

# ============================================
# 主目标
# ============================================

$(TARGET): $(OBJS)
	$(CC) $(OBJS) -o $(TARGET)

# ============================================
# 编译规则：.c → .o
# ============================================

# $< 是第一个依赖（.c 文件）
# $@ 是目标（.o 文件）
src/%.o: src/%.c
	$(CC) $(CFLAGS) -c $< -o $@

# ============================================
# 辅助目标
# ============================================

.PHONY: clean run rebuild

# 清理：删除 exe 和所有 .o（- 前缀表示忽略错误，文件不存在也不报错）
clean:
	-del /Q $(TARGET)
	-del /Q src\*.o

# 运行：先编译，再执行
run: $(TARGET)
	./$(TARGET)

# 重新编译：先清理再编译
rebuild: clean $(TARGET)